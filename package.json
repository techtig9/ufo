{
  "name": "ufo",
  "version": "0.1.0",
  "private": true,
  "description": "ufo \u2014 AI UI/UX design platform. Describe a project, get a full clickable multi-screen prototype.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "preflight": "node scripts/preflight.mjs",
    "test": "node --experimental-strip-types --import ./tests/ts-resolver.mjs --test tests/*.test.ts",
    "test:db": "./supabase/tests/run.sh",
    "test:browser": "node tests/browser/phase1.mjs && node tests/browser/responsive.mjs && node tests/browser/a11y.mjs && node tests/browser/contrast.mjs && node tests/browser/palette.mjs && node tests/browser/inspector.mjs",
    "db:apply": "./scripts/apply-migrations.sh",
    "db:verify": "./scripts/verify-database.sh"
  },
  "dependencies": {
    "@google/generative-ai": "^0.15.0",
    "@monaco-editor/react": "^4.6.0",
    "@supabase/ssr": "^0.4.0",
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.11",
    "jszip": "^3.10.1",
    "next": "^16.3.4",
    "qrcode": "^1.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "playwright": "^1.63.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "dompurify": "^3.4.13"
  }
}
