# Environment variables for a Vercel deployment, in the order they matter.
#
# A PREVIEW deploy works with none of these set: the app builds, serves its
# public pages, and shows a setup notice anywhere it needs a database.
# A PRODUCTION deploy is blocked by `npm run preflight` until the required ones
# are present — see scripts/preflight.mjs.
#
# NOTE: the two NEXT_PUBLIC_ values are compiled into the browser bundle at
# build time. Changing them requires a REDEPLOY, not just a restart.

# --- Required before a production deploy -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# --- Required before launch: these appear on the Terms, Privacy, Refunds and
#     Cookie pages, the footer and the contact page. Not invented for you —
#     they are facts about your business.
UFO_COMPANY_LEGAL_NAME=
UFO_COMPANY_DISPLAY_NAME=
UFO_COMPANY_CONTACT_EMAIL=
UFO_COMPANY_JURISDICTION=
UFO_LEGAL_EFFECTIVE_DATE=
UFO_LAUNCH_DATE=

# --- Recommended: each degrades a feature rather than breaking the app ------
NEXT_PUBLIC_SITE_URL=            # used in emails and share links
ANTHROPIC_API_KEY=               # AI cascade fallback
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
RESEND_API_KEY=                  # without it, email silently no-ops
EMAIL_FROM=
PADDLE_API_KEY=                  # without these, billing no-ops
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
CRON_SECRET=                     # without it, free-tier credits never reset
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  # bot protection on signup/contact
TURNSTILE_SECRET_KEY=
