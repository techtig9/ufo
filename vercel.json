{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run preflight && npm run build",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/proto/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/invite",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
