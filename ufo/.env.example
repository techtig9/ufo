# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paddle billing (required once you enable paid plans) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_1000=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_5000=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_10000=
# Optional override — defaults to https://api.paddle.com in lib/paddle-api.ts.
# Point at https://sandbox-api.paddle.com while testing.
PADDLE_API_BASE=

# --- Transactional email (required once you enable Paddle/lifecycle email) ---
RESEND_API_KEY=
EMAIL_FROM=ufo <hello@yourdomain.com>
# Optional — where the /contact form delivers to. Defaults to EMAIL_FROM if unset.
SUPPORT_INBOX_EMAIL=

# --- Bot protection on signup/login (optional — silently no-ops if unset) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Not read by this app's code — Supabase itself calls Turnstile's verify
# API server-side using this key. Set it under Authentication > Bot and
# Abuse Protection in the Supabase dashboard, matching the site key above.
TURNSTILE_SECRET_KEY=

# --- Cron (required for Free-tier credits to ever reset — see README) ---
CRON_SECRET=

# --- Gemini model overrides (optional — see lib/gemini.ts for defaults) ---
GEMINI_PREMIUM_MODEL=
GEMINI_FLASH_MODEL=
