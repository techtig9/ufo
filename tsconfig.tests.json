{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // The tests are executed by `node --experimental-strip-types`, which is a
    // real ESM runtime and therefore needs explicit .ts specifiers. The app
    // itself is bundled by Next and keeps extensionless imports.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["tests/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules"]
}
