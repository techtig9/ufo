# --- Required for core app ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: if unset, complex AI generation falls back to the available OpenAI-compatible provider.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paddle billing (required once you enable paid plans) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_1000=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_5000=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_10000=
# Optional override — defaults to https://api.paddle.com in lib/paddle-api.ts.
# Point at https://sandbox-api.paddle.com while testing.
PADDLE_API_BASE=

# --- Transactional email (required once you enable Paddle/lifecycle email) ---
RESEND_API_KEY=
EMAIL_FROM=ufo <hello@yourdomain.com>
# Optional — where the /contact form delivers to. Defaults to EMAIL_FROM if unset.
SUPPORT_INBOX_EMAIL=

# --- Bot protection on signup/login (optional — silently no-ops if unset) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Not read by this app's code — Supabase itself calls Turnstile's verify
# API server-side using this key. Set it under Authentication > Bot and
# Abuse Protection in the Supabase dashboard, matching the site key above.
TURNSTILE_SECRET_KEY=

# --- Cron (required for Free-tier credits to ever reset — see README) ---
# The route fails CLOSED: with this unset /api/cron/reset-credits returns 503
# and no credits are reset. (It previously compared against the literal string
# "Bearer undefined", so an unset secret left the endpoint callable by anyone.)
CRON_SECRET=

# --- AI model overrides (optional) ---
CLAUDE_MODEL=claude-fable-5
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_MODEL=llama-3.3-70b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Company details shown on legal pages, footer and contact (REQUIRED) ---
# These render into the Terms, Privacy, Refunds and Cookie pages, the footer and
# the contact page. `npm run preflight` FAILS under CI or NODE_ENV=production
# while any of them is empty, so a build cannot ship placeholder legal copy.
#
# They are deliberately not hardcoded: a legal entity name, jurisdiction and
# contact address are facts about your business, not source code.
UFO_COMPANY_LEGAL_NAME=
UFO_COMPANY_DISPLAY_NAME=
UFO_COMPANY_CONTACT_EMAIL=
# Governing law for the Terms, e.g. "England and Wales"
UFO_COMPANY_JURISDICTION=
# Shown as "Last updated" on the legal documents, e.g. "5 September 2026"
UFO_LEGAL_EFFECTIVE_DATE=
# Shown on the changelog, e.g. "September 2026"
UFO_LAUNCH_DATE=
